# .env.example — 环境变量示例文件 / Environment variable example file
#
# 复制此文件为 .env 并填入实际值，或在部署环境中直接设置这些环境变量。
# Copy this file to .env and fill in the real values,
# or set these environment variables directly in your deployment environment.
#
# ⚠️  切勿将含有真实密钥的 .env 文件提交到版本控制系统。
# ⚠️  Never commit a .env file containing real secrets to version control.

# ─────────────────────────────────────────
# MySQL 数据库密码 / MySQL database password
# ─────────────────────────────────────────
MYSQL_PASSWORD=your_mysql_password_here

# ─────────────────────────────────────────
# Redis 密码 / Redis password
# ─────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ─────────────────────────────────────────
# PostgreSQL 数据库密码（pgvector 向量库）/ PostgreSQL database password (pgvector store)
# ─────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here

# ─────────────────────────────────────────
# Sa-Token JWT 签名密钥 / Sa-Token JWT signing secret key
# 请使用至少 32 位的随机字符串替换占位符。
# Replace with a random string of at least 32 characters.
# ─────────────────────────────────────────
SA_TOKEN_JWT_SECRET=your_sa_token_jwt_secret_here

# ─────────────────────────────────────────
# 阿里云 DashScope API 密钥（大模型 & 嵌入模型）/ Alibaba Cloud DashScope API key (LLM & embedding model)
# 在 https://dashscope.console.aliyun.com/ 获取。
# Obtain from https://dashscope.console.aliyun.com/
# ─────────────────────────────────────────
AI_DASHSCOPE_API_KEY=your_dashscope_api_key_here
