<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangzs.rag.mapper.ChatSessionMapper">

    <resultMap id="BaseResultMap" type="com.wangzs.rag.model.entity.ChatSession">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="userId" column="user_id"/>
        <result property="kbId" column="kb_id"/>
        <result property="title" column="title"/>
        <result property="messageCount" column="message_count"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, session_id, user_id, kb_id, title, message_count, created_time, updated_time, deleted
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM chat_session
        WHERE deleted = 0
          AND user_id = #{userId}
        ORDER BY updated_time DESC
    </select>

</mapper>
