<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangzs.rag.mapper.ConfigMapper">

    <resultMap id="BaseResultMap" type="com.wangzs.rag.model.entity.Config">
        <id property="id" column="id"/>
        <result property="configKey" column="config_key"/>
        <result property="configValue" column="config_value"/>
        <result property="valueType" column="value_type"/>
        <result property="description" column="description"/>
        <result property="isSystem" column="is_system"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, config_key, config_value, value_type, description, is_system,
        created_time, updated_time, deleted
    </sql>

    <select id="selectAllActive" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_config
        WHERE deleted = 0
    </select>

    <select id="selectByKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_config
        WHERE config_key = #{configKey}
          AND deleted = 0
    </select>

</mapper>
